{
  "name": "pocket-pantheon",
  "version": "0.7.0",
  "private": true,
  "description": "A browser god game. A living pixel world runs itself, and you shape it.",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint:text": "python tools/lint_text.py",
    "lint:palette": "python tools/palette.py --check",
    "test": "npm run typecheck && npm run lint:text && npm run lint:palette && vitest run",
    "test:e2e": "playwright test",
    "test:long": "vitest run --config vitest.long.config.ts",
    "bench": "node tools/bench.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "coi-serviceworker": "^0.1.7",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
