{
  "name": "pocket-pantheon",
  "version": "0.1.0",
  "private": true,
  "description": "A browser god game. A living pixel world runs itself, and you shape it.",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint:text": "python tools/lint_text.py",
    "test": "npm run typecheck && npm run lint:text && vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "coi-serviceworker": "^0.1.7",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
